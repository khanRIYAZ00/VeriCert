# Core app settings. Generate a unique secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VERICERT_ENV=development
VERICERT_TOKEN_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
VERICERT_FRONTEND_URL=http://127.0.0.1:5173

# Required in production. Redis must be private and protected with authentication.
# VERICERT_REDIS_URL=redis://:password@127.0.0.1:6379/0

# SMTP settings for certificate email delivery
VERICERT_SMTP_HOST=smtp.gmail.com
VERICERT_SMTP_PORT=587
VERICERT_SMTP_TLS=true
VERICERT_SMTP_USER=your-account@example.com
VERICERT_SMTP_PASSWORD=your-app-password
VERICERT_SMTP_FROM=your-account@example.com

# Optional: use a different database instead of the local SQLite file
# VERICERT_DATABASE_URL=sqlite:///./vericert.db
